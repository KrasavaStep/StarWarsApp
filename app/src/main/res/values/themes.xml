<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StarWarsApp" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Фон окна (делаем черным под стиль Star Wars) -->
